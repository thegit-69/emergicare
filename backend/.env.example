# ================================================================
# EmergiCare – Backend Environment Variables – REFERENCE TEMPLATE
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ================================================================
# OPTION A: LOCAL DEVELOPMENT (docker-compose postgres)
# ================================================================
# DB_HOST is auto-overridden to "postgres" by docker-compose.yml.
# These values must match POSTGRES_* in root .env
DB_HOST=postgres
DB_PORT=5432
DB_NAME=emergicare_db
DB_USER=emergicare
DB_PASSWORD=emergicare_secret
PORT=3001
JWT_SECRET=replace_me_use_openssl_rand_hex_64

# ================================================================
# OPTION B: SUPABASE (Managed PostgreSQL – no BaaS features)
# ================================================================
# How to get the connection string:
#   1. Supabase Dashboard → Project → Settings → Database
#   2. Choose "Transaction mode" (port 6543) for a C++ backend
#   3. Copy the connection string, append ?sslmode=require
#
# When DATABASE_URL is set, all DB_HOST/DB_PORT/etc. are IGNORED.
#
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# JWT_SECRET=your_production_jwt_secret_minimum_32_chars
# PORT=3001

# ================================================================
# OPTION C: AZURE CONTAINER APPS (Production Deployment)
# ================================================================
# On Azure, do NOT use a .env file. Instead:
#   1. Azure Portal → Container App → Secrets → Add:
#        database-url  = <supabase connection string>
#        jwt-secret    = <strong random secret>
#   2. Container App → Environment Variables → Add:
#        DATABASE_URL  = secretref:database-url
#        JWT_SECRET    = secretref:jwt-secret
#        PORT          = 3001
#
# Azure CLI equivalent:
#   az containerapp secret set \
#     --name emergicare-backend \
#     --resource-group emergicare-rg \
#     --secrets "database-url=postgresql://..." "jwt-secret=..."
#
#   az containerapp update \
#     --name emergicare-backend \
#     --resource-group emergicare-rg \
#     --set-env-vars \
#       "DATABASE_URL=secretref:database-url" \
#       "JWT_SECRET=secretref:jwt-secret" \
#       "PORT=3001"

# ================================================================
# NOTES ON CONNECTION LIMITS
# ================================================================
# Supabase free tier:  max 60 direct connections (use Transaction mode pooler)
# Supabase pro tier:   max 200 direct connections
# Our backend uses:    5 connection pool connections (see main.cpp)
# This is well within Supabase's limits.
